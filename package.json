{
  "name": "hitrack-blaster-server",
  "version": "1.0.0",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix server test && npm --prefix client test",
    "build": "npm --prefix client install && npm --prefix client run build",
    "install-all": "npm install && npm --prefix server install && npm --prefix client install",
    "backup:db": "node server/scripts/backupDatabase.js",
    "restore:db": "node server/scripts/restoreDatabase.js",
    "migrate:scoring": "node server/scripts/migrateScoringEvents.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.9",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
